6:["$","section",null,{"children":[["$","h2",null,{"children":"6. Data Retention & Deletion"}],["$","p",null,{"children":["Guild settings are retained until the server removes iSound, at which point associated data is deleted on a routine cleanup cycle. Playlists persist under your user ID until you delete them with"," ",["$","code",null,{"children":"/pl-delete"}]," or request full account data deletion by contacting us (see Section 9). We may retain minimal data as required to comply with legal obligations or resolve disputes."]}]]}]
7:["$","section",null,{"children":[["$","h2",null,{"children":"7. Children's Privacy"}],["$","p",null,{"children":"iSound is intended for use in compliance with Discord's Terms of Service, which require users to meet Discord's minimum age requirement. We do not knowingly collect data from children below that age, and any such data discovered will be deleted."}]]}]
8:["$","section",null,{"children":[["$","h2",null,{"children":"8. Your Rights"}],["$","p",null,{"children":["Depending on your location, you may have rights to access, correct, or delete your data. You can self-serve most of this through commands like ",["$","code",null,{"children":"/pl-list"}],", ",["$","code",null,{"children":"/pl-delete"}],", and server settings commands. For anything else, reach out using the contact details below."]}]]}]
9:["$","section",null,{"children":[["$","h2",null,{"children":"9. Contact"}],["$","p",null,{"children":["Questions about this policy or a data request can be sent through the ",["$","code",null,{"children":"/report-bug"}]," command or via our support server, linked from the Discord invite page."]}]]}]
a:["$","section",null,{"children":[["$","h2",null,{"children":"10. Changes to This Policy"}],["$","p",null,{"children":"We may update this Privacy Policy as iSound's features change. Material changes will be reflected by updating the \"Last updated\" date at the top of this page. Continued use of iSound after changes take effect constitutes acceptance of the revised policy."}]]}]
