0:{"buildId":"9LO3nXcLq6Yom-i9Osb2S","data":[{"rsc":["$","$1","c",{"children":[[["$","$L2",null,{}],["$","main",null,{"className":"bg-background min-h-screen pt-[120px] pb-24","children":["$","div",null,{"className":"container-max max-w-3xl","children":[["$","$L3",null,{"href":"/","className":"inline-flex items-center gap-2 text-textMuted hover:text-accent transition-colors text-sm mb-8 focus-ring","children":[["$","$L4",null,{"iconNode":[["path",{"d":"m12 19-7-7 7-7","key":"1l729n"}],["path",{"d":"M19 12H5","key":"x3x0zl"}]],"className":"lucide-arrow-left","size":16}],"Back to home"]}],["$","h1",null,{"className":"font-heading text-3xl sm:text-4xl text-text mb-3","children":"Privacy Policy"}],["$","p",null,{"className":"text-textDim text-sm mb-12","children":["Last updated: ","August 15, 2026"]}],["$","div",null,{"className":"legal-prose flex flex-col gap-10","children":[["$","section",null,{"children":[["$","h2",null,{"children":"1. Overview"}],["$","p",null,{"children":"This Privacy Policy explains what information iSound (\"the Bot,\" \"we,\" \"us\") collects when you use it on Discord or visit this website, why we collect it, and how it's handled. By inviting iSound to a server or using its commands, you agree to the practices described here."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"2. Information We Collect"}],["$","p",null,{"children":"iSound collects only what it needs to function:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Server (guild) settings"}]," — DJ role, default volume, announcement channel, custom embed color, and autoplay preference, tied to your server's Discord ID."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Playlists"}]," — playlist names and track lists you create, tied to your Discord user ID so they follow you across servers."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Command usage data"}]," — the slash command and options you send (e.g. a song query), processed to run the command. This is not stored beyond what's needed for playlists or settings above."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Bug reports"}]," — if you use"," ",["$","code",null,{"children":"/report-bug"}],", the description and any optional screenshot you submit."]}]]}],["$","p",null,{"children":["iSound does ",["$","strong",null,{"children":"not"}]," read, log, or store the content of your regular Discord messages. It only ever sees data explicitly sent through its slash commands."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"3. How We Use Information"}],["$","ul",null,{"children":[["$","li",null,{"children":"To play music, manage queues, and apply your saved settings"}],["$","li",null,{"children":"To keep your playlists available across servers and sessions"}],["$","li",null,{"children":"To enforce DJ roles and per-server permissions"}],["$","li",null,{"children":"To diagnose and fix bugs you report"}],["$","li",null,{"children":"To monitor node health and prevent abuse of the service"}]]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"4. Where Data Is Stored"}],["$","p",null,{"children":"Settings and playlists are stored in a MongoDB database operated by the iSound team. Reasonable technical safeguards are in place, but no online storage system can be guaranteed 100% secure. Audio is streamed through Lavalink nodes and is not recorded or retained."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"5. Third-Party Services"}],["$","p",null,{"children":["iSound retrieves audio and metadata from third-party platforms — including YouTube, SoundCloud, Bandcamp, Twitch, and Vimeo — to fulfill playback requests. Your use of iSound to access these platforms is also subject to their respective terms and privacy policies. iSound operates within Discord and is bound by"," ",["$","a",null,{"href":"https://discord.com/privacy","target":"_blank","rel":"noopener noreferrer","children":"Discord's Privacy Policy"}]," ","and"," ","$L5"," ","in addition to this policy."]}]]}],"$L6","$L7","$L8","$L9","$La"]}]]}]}],"$Lb"],["$Lc","$Ld"],"$Le"]}],"isPartial":"$@f","staleTime":"$10","varyParams":null},{"rsc":"$L11","isPartial":"$@12","staleTime":"$10","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$10","varyParams":"$15"},{"rsc":"$L16","isPartial":"$@17","staleTime":"$10","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
